generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tenant {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  domain            String
  management_email  String
  brand_color       String?        @default("#00E5C3")
  logo_url          String?
  device_limit      Int            @default(100)
  status            String         @default("active")
  plan              String         @default("cloud_basic")
  idle_minutes      Int            @default(30)
  password_days     Int            @default(30)
  ticker_text       String         @default("")
  ticker_enabled    Boolean        @default(false)
  users             user[]
  kb_articles       kb_article[]
  devices           device[]
  device_links      device_link[]
  alerts            alert[]
  dashboards        dashboard[]
  audit_logs        audit_log[]
  subscription      subscription?
  agents            agent[]
  cmdb_cis          cmdb_ci[]
  notify_channels    notify_channel[]
  ai_setting         ai_setting?
  ticket_connectors  ticket_connector[]
  tickets            ticket[]
  notifications      notification[]
  buildings          building[]
  floors             floor[]
  floor_placements   floor_placement[]
}

model user {
  id            String      @id @default(cuid())
  tenant_id     String
  email         String      @unique
  name          String?
  password_hash String
  role          String      @default("viewer")
  totp_secret          String?
  totp_enabled         Boolean     @default(false)
  sso_provider         String?
  password_changed_at  DateTime    @default(now())
  created_at           DateTime    @default(now())
  tenant               tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  audit_logs    audit_log[]
  notifications notification[]

  @@index([tenant_id])
}

model device {
  id            String        @id @default(cuid())
  tenant_id     String
  hostname      String
  ip            String
  type          String
  status        String        @default("unknown")
  vendor        String?
  location      String?
  city          String?
  last_seen     DateTime?
  created_at    DateTime      @default(now())
  tenant        tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  alerts        alert[]
  sla           sla?
  metrics       metric[]
  links_from    device_link[] @relation("from_device")
  links_to      device_link[] @relation("to_device")
  agent         agent?
  cmdb_cis      cmdb_ci[]
  floor_placements floor_placement[]

  @@unique([tenant_id, hostname])
  @@unique([ip])
  @@index([tenant_id])
  @@index([tenant_id, status])
}

model device_link {
  id             String  @id @default(cuid())
  tenant_id      String
  from_device_id String
  to_device_id   String
  status         String  @default("up")
  tenant         tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  from_device    device  @relation("from_device", fields: [from_device_id], references: [id], onDelete: Cascade)
  to_device      device  @relation("to_device", fields: [to_device_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model alert {
  id         String   @id @default(cuid())
  tenant_id  String
  device_id  String
  event      String
  status     String   @default("firing")
  severity   String   @default("critical")
  created_at DateTime @default(now())
  resolved_at DateTime?
  tenant     tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  device     device   @relation(fields: [device_id], references: [id], onDelete: Cascade)
  tickets    ticket[]

  @@index([tenant_id])
  @@index([device_id])
  @@index([tenant_id, status])
  @@index([device_id, event, status])
}

model sla {
  id         String @id @default(cuid())
  device_id  String @unique
  uptime_30d Float  @default(100)
  device     device @relation(fields: [device_id], references: [id], onDelete: Cascade)
}

model metric {
  id           String   @id @default(cuid())
  device_id    String
  ts           DateTime @default(now())
  cpu_percent  Float
  ram_percent  Float
  disk_percent Float
  device       device   @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id, ts])
}

model dashboard {
  id        String @id @default(cuid())
  tenant_id String
  name      String
  layout    Json
  tenant    tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model audit_log {
  id         String   @id @default(cuid())
  tenant_id  String
  user_id    String
  action     String
  created_at DateTime @default(now())
  tenant     tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model subscription {
  id        String @id @default(cuid())
  tenant_id String @unique
  status    String
  tenant    tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

model agent {
  id         String    @id @default(cuid())
  tenant_id  String
  device_id  String    @unique
  token      String    @unique
  version    String    @default("1.0.0")
  last_seen  DateTime?
  status     String    @default("pending")
  tenant     tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  device     device    @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model cmdb_ci {
  id                String    @id @default(cuid())
  tenant_id         String
  device_id         String?
  ci_type           String
  name              String
  asset_tag         String?
  serial            String?
  owner             String?
  status            String    @default("in_service")
  location          String?
  external_asset_id String?
  external_ci_id    String?
  last_synced_at    DateTime?
  last_sync_error   String?
  tenant            tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  device            device?   @relation(fields: [device_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
}

model notify_channel {
  id             String    @id @default(cuid())
  tenant_id      String
  type           String
  name           String
  enabled        Boolean   @default(false)
  config         Json      @default("{}")
  severities     String    @default("critical,warning")
  last_tested_at DateTime?
  last_status    String?
  tenant         tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, type])
  @@index([tenant_id])
}

model ticket_connector {
  id             String    @id @default(cuid())
  tenant_id      String
  provider       String
  name           String
  enabled        Boolean   @default(false)
  direction      String    @default("both")
  auto_open      Boolean   @default(false)
  severities     String    @default("critical")
  base_url       String    @default("")
  api_user       String    @default("")
  api_key        String?
  config         Json      @default("{}")
  inbound_token  String    @unique
  last_tested_at DateTime?
  last_status    String?
  created_at     DateTime  @default(now())
  tenant         tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tickets        ticket[]

  @@index([tenant_id])
}

model ticket {
  id             String           @id @default(cuid())
  tenant_id      String
  connector_id   String
  alert_id       String?
  device_id      String?
  external_id    String           @default("")
  external_url   String?
  title          String
  body           String           @default("")
  status         String           @default("open")
  priority       String           @default("high")
  direction      String
  last_error     String?
  last_synced_at DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  tenant         tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  connector      ticket_connector @relation(fields: [connector_id], references: [id], onDelete: Cascade)
  alert          alert?           @relation(fields: [alert_id], references: [id], onDelete: SetNull)
  comments       ticket_comment[]

  @@index([tenant_id])
  @@index([alert_id])
  @@index([connector_id, external_id])
  @@index([tenant_id, status])
}

model ticket_comment {
  id         String   @id @default(cuid())
  tenant_id  String
  ticket_id  String
  author     String
  body       String
  direction  String
  created_at DateTime @default(now())
  ticket     ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
}

model notification {
  id         String    @id @default(cuid())
  tenant_id  String
  user_id    String
  title      String
  body       String
  kind       String    @default("alert")
  ref_id     String?
  severity   String    @default("warning")
  read_at    DateTime?
  created_at DateTime  @default(now())
  tenant     tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@index([tenant_id, created_at])
}

model kb_article {
  id          String   @id @default(cuid())
  tenant_id   String
  title       String
  slug        String
  body        String   @default("")
  category    String   @default("general")
  tags        String   @default("")
  published   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  tenant      tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, slug])
  @@index([tenant_id, published])
}

model ai_setting {
  id                String    @id @default(cuid())
  tenant_id         String    @unique
  enabled           Boolean   @default(true)
  mode              String    @default("local")
  provider          String    @default("openai")
  base_url          String    @default("https://api.openai.com/v1")
  model             String    @default("gpt-4o-mini")
  api_key           String?
  copilot_enabled   Boolean   @default(true)
  insights_enabled  Boolean   @default(true)
  last_tested_at    DateTime?
  last_status       String?
  tenant            tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

/// Platform-wide role → permission grants. Managed by superadmin Capability Matrix.
model role_capability {
  role       String
  permission String
  allowed    Boolean  @default(true)
  updated_at DateTime @updatedAt

  @@id([role, permission])
  @@index([role])
}

model building {
  id         String   @id @default(cuid())
  tenant_id  String
  name       String
  address    String?
  created_at DateTime @default(now())
  tenant     tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  floors     floor[]

  @@index([tenant_id])
}

model floor {
  id          String   @id @default(cuid())
  tenant_id   String
  building_id String
  name        String
  level       Int      @default(0)
  image_mime  String?
  image_data  Bytes?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  tenant      tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  building    building @relation(fields: [building_id], references: [id], onDelete: Cascade)
  placements  floor_placement[]

  @@index([tenant_id])
  @@index([building_id])
}

model floor_placement {
  id         String   @id @default(cuid())
  tenant_id  String
  floor_id   String
  device_id  String
  x          Float
  y          Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  tenant     tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  floor      floor    @relation(fields: [floor_id], references: [id], onDelete: Cascade)
  device     device   @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@unique([floor_id, device_id])
  @@index([tenant_id])
  @@index([device_id])
}
