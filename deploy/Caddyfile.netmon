# Paste into the WorkPulse Caddyfile (the volume mounted on workpulse-prod-caddy-1).
# Requires NETMON web on network workpulse-prod_edge with alias netmon-web.
# Add more tenant hosts to the site list as you onboard them.

netmon.click, www.netmon.click, demo.netmon.click, acme.netmon.click, jakarta.netmon.click {
	encode gzip
	reverse_proxy netmon-web:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
