DATABASE_URL=postgresql://nms:changeme@postgres:5432/nms
REDIS_URL=redis://redis:6379
JWT_SECRET=change-this-to-a-long-random-string
ENCRYPT_KEY=change-this-32-char-encrypt-key
NEXTAUTH_SECRET=change-this-nextauth-secret
IS_SAAS=true
NEXTAUTH_URL=https://netmon.click
APP_URL=https://netmon.click
# Absolute JWT lifetime in hours (1–24). Idle timeout is separate (per tenant on Security).
SESSION_MAX_HOURS=8
SERVER_IP=103.190.214.224
# Traefik host ports. Leave unset only if 80 and 443 are free on this host.
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_HTTPS_PORT=443
# App port when Traefik cannot bind 80/443 (shared VPS). Point the existing reverse proxy here.
WEB_HOST_PORT=3008
# Existing Traefik on this host (deploy/docker-compose.proxy.yml). Find name: docker network ls
# TRAEFIK_NETWORK=novacrm_default
# TRAEFIK_CERTRESOLVER=le
# Set in the shell before compose build on a small VPS (hides fewer errors, less RAM):
# COMPOSE_BAKE=false
# COMPOSE_PARALLEL_LIMIT=1
SEED_ADMIN_EMAIL=admin@netmon.click
SEED_ADMIN_PASSWORD=ChangeMeNow!
# Local LLM (Ollama on the same host). Leave AI_API_KEY empty.
# From Docker use http://host.docker.internal:11434/v1
AI_API_KEY=
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.1
